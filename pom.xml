<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>br.edu.fiap</groupId>
    <artifactId>desafio-bancario-correcao</artifactId>
    <version>1.0.0</version>
    <name>Desafio Bancário Correção</name>
    <description>Casca do desafio bancário para implementação das camadas da API</description>

    <properties>
        <java.version>25</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            Usamos somente o módulo de criptografia nesta aula. Ele fornece o
            PasswordEncoder e o BCryptPasswordEncoder sem ativar, ainda, o
            filtro completo de autenticação do Spring Security.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!--
            A Aula 33 ativa a cadeia completa do Spring Security. O starter
            contém os filtros HTTP; o Resource Server lê o Bearer Token e usa
            o módulo JOSE para validar a assinatura JWT.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.1</version>
        </dependency>
        <!--
            Pacote de testes do Spring Boot.

            Ele inclui JUnit 5, Mockito, AssertJ, MockMvc e as anotações usadas
            pelos testes unitários e pelos testes de integração da camada web.
            O escopo test impede que essas bibliotecas sejam levadas para a
            aplicação quando o projeto for empacotado.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Módulo específico do Spring Boot 4 para @WebMvcTest e MockMvc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
                O Mockito precisa instrumentar as classes durante os testes.

                No JDK 25, depender do autoanexo dinâmico pode gerar aviso ou
                falhar em ambientes mais restritos. O Surefire inicia o mesmo
                JAR do Mockito explicitamente como javaagent. A versão vem do
                gerenciamento de dependências do Spring Boot, portanto não há
                uma segunda versão para manter manualmente.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
